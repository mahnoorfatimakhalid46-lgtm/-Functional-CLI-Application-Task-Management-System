import os
import json
import time
from datetime import datetime

# Global configuration and storage mock
DATA_FILE = "tasks_db.json"
current_user = None

def clear_screen():
    """Clears the terminal screen based on the OS."""
    os.system('cls' if os.name == 'nt' else 'clear')

def load_data():
    """Loads application data from a JSON file."""
    if not os.path.exists(DATA_FILE):
        return {"users": {"admin": "password123"}, "tasks": {}}
    try:
        with open(DATA_FILE, 'r') as file:
            return json.load(file)
    except json.JSONDecodeError:
        print("⚠️ Data corrupted. Initializing fresh database.")
        return {"users": {"admin": "password123"}, "tasks": {}}

def save_data(data):
    """Saves the application data state to a JSON file."""
    try:
        with open(DATA_FILE, 'w') as file:
            json.dump(data, file, indent=4)
    except IOError:
        print("❌ Error: Could not save data to disk.")

def authenticate_user(data):
    """Handles the user sign-in process."""
    global current_user
    clear_screen()
    print("=== System Authentication ===")
    username = input("Enter Username: ").strip()
    password = input("Enter Password: ").strip()

    if username in data["users"] and data["users"][username] == password:
        current_user = username
        print(f"\n✅ Login successful! Welcome back, {username}.")
        time.sleep(1.5)
        return True
    else:
        print("\n❌ Invalid username or password.")
        input("Press Enter to try again...")
        return False

def add_task(data):
    """Creates a new task and maps it to the logged-in user."""
    clear_screen()
    print(f"=== Create New Task (Logged in as: {current_user}) ===")
    title = input("Task Title: ").strip()
    if not title:
        print("Task title cannot be empty!")
        input("\nPress Enter to return...")
        return

    description = input("Task Description: ").strip()
    priority = input("Priority (Low/Medium/High): ").strip().capitalize()
    if priority not in ["Low", "Medium", "High"]:
        priority = "Medium"

    task_id = str(int(time.time()))  # Generate unique ID based on timestamp
    
    if current_user not in data["tasks"]:
        data["tasks"][current_user] = []

    task_entry = {
        "id": task_id,
        "title": title,
        "description": description,
        "priority": priority,
        "status": "Pending",
        "created_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    }

    data["tasks"][current_user].append(task_entry)
    save_data(data)
    print(f"\n🎉 Task '{title}' created successfully!")
    input("\nPress Enter to continue...")

def view_tasks(data):
    """Displays all tasks belonging to the authenticated user."""
    clear_screen()
    print(f"=== Your Task Ledger ({current_user}) ===")
    
    user_tasks = data["tasks"].get(current_user, [])
    
    if not user_tasks:
        print("No tasks found. Your planner is empty!")
        input("\nPress Enter to return...")
        return

    for index, task in enumerate(user_tasks, start=1):
        print(f"\n[{index}] ID: {task['id']} | Status: {task['status']}")
        print(f"    Title: {task['title']}")
        print(f"    Description: {task['description']}")
        print(f"    Priority: {task['priority']} | Created: {task['created_at']}")
        print("-" * 40)
        
    return user_tasks

def manage_tasks_menu(data):
    """Sub-menu interface to process, complete, or delete tasks."""
    while True:
        user_tasks = view_tasks(data)
        if not user_tasks:
            break
            
        print("\nOptions: [1] Mark Complete | [2] Delete Task | [3] Return to Main Menu")
        choice = input("Select an option (1-3): ").strip()
        
        if choice == "3":
            break
            
        if choice in ["1", "2"]:
            try:
                idx = int(input("Enter the list number of the task: ")) - 1
                if 0 <= idx < len(user_tasks):
                    target_task = user_tasks[idx]
                    if choice == "1":
                        target_task["status"] = "Completed"
                        print(f"Task marked as Completed.")
                    elif choice == "2":
                        user_tasks.pop(idx)
                        print(f"Task successfully deleted.")
                    save_data(data)
                else:
                    print("Invalid task selection index.")
            except ValueError:
                print("Please enter a valid numeric integer.")
            time.sleep(1.5)

def main_dashboard():
    """Main execution loop tracking application lifecycle."""
    db_data = load_data()
    
    # Force authentication loop
    while not current_user:
        if not authenticate_user(db_data):
            continue

    # Main application state loop
    while True:
        clear_screen()
        print(f"=====================================")
        print(f"       ENTERPRISE TASK PLANNER       ")
        print(f"=====================================")
        print(f" Active Session: {current_user}")
        print(f"-------------------------------------")
        print(" [1] View & Manage Existing Tasks")
        print(" [2] Add a New Task")
        print(" [3] System Status / Environment Info")
        print(" [4] Logout & Exit")
        print(f"=====================================")
        
        selection = input("Choose an option (1-4): ").strip()
        
        if selection == "1":
            manage_tasks_menu(db_data)
        elif selection == "2":
            add_task(db_data)
        elif selection == "3":
            clear_screen()
            print("=== Environment Diagnostics ===")
            print(f"Database Path: {os.path.abspath(DATA_FILE)}")
            print(f"System Time: {datetime.now()}")
            print(f"Total Users Registered: {len(db_data['users'])}")
            input("\nPress Enter to return...")
        elif selection == "4":
            print("\nShutting down session safely. Goodbye!")
            break
        else:
            print("Invalid input choice. Please select 1 through 4.")
            time.sleep(1)

if __name__ == "__main__":
    try:
        main_dashboard()
    except KeyboardInterrupt:
        print("\n\nApplication interrupted by user. Exiting safely.")
